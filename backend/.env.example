# Конфигурация сервера «Моё дело»
# Скопируйте этот файл в .env и заполните своими значениями

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=moe_user
DB_PASSWORD=moe_password
DB_NAME=moe_delo

# JWT секрет (ОБЯЗАТЕЛЬНО измените в продакшене!)
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Порт сервера
PORT=8080

# Режим работы (development/production)
ENV=development
